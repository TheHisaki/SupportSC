# Hostinger (Apache/LiteSpeed)

# Web Bluetooth only works over HTTPS: force it.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Never serve git metadata or the local test tools if they end up on the server.
RedirectMatch 404 /\.git
RedirectMatch 404 ^/local(/|$)

# ES modules must be served as JavaScript.
AddType text/javascript .js

# Always get the latest version after a push (no stale cache on the phone).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
